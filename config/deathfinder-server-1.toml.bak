[death_messages]
	#Show death message for players.
	playerDeaths = false
	#Show death message for villagers.
	villagerDeaths = false
	#Show death message for tamed entities.
	petDeaths = false
	#Show death message for named entities.
	namedEntityDeaths = false
	#Show death message for all entities. Silence individual entities using the 'deathfinder:silent_deaths' entity type tag.
	allDeaths = false

[death_message_components]
	#Add position component to death messages.
	positionComponent = false
	#Add distance component to death messages.
	distanceComponent = false
	#Add dimension component to death messages.
	dimensionComponent = false
	#Who should be allowed to click the position component to teleport there.
	#Allowed Values: EVERYONE, OPERATORS_ONLY, NO_ONE
	allowTeleporting = "NO_ONE"
